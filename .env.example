# Keyfolio runtime configuration — PLACEHOLDERS ONLY, no real values.
# Copy to .env (git-ignored) and fill in only the values your slice actually needs.

# Required, explicit. One of: FIXTURE | TESTNET | LIVE. No default; never silently fixtures.
KEYFOLIO_MODE=FIXTURE

# Chain identity (network-scoped). One of: mainnet | testnet.
NEAR_NETWORK=
NEAR_RPC_URL=

# Private PostgreSQL (libpq URL). Required in TESTNET/LIVE.
DATABASE_URL=

# Upstream confidential-intents provider (no fake fallback in non-fixture modes).
PROVIDER_BASE_URL=
PROVIDER_PARTNER_JWT=

# Contract identities (required in LIVE).
ACCESS_CONTRACT_ID=
SUBSCRIPTION_FT_CONTRACT_ID=

# Secrets recognized for later auth/provider tasks (not consumed by KF-02a slice).
TOKEN_ENCRYPTION_KEY=
CREDENTIAL_HASH_KEY=
SESSION_SECRET=
APP_ORIGIN=